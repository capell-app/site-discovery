{
    "manifest-version": 3,
    "name": "capell-app/site-discovery",
    "slug": "site-discovery",
    "displayName": "Site Discovery",
    "kind": "package",
    "capellApiVersion": "^1.0",
    "version": "1.0.0",
    "launchStatus": "shipped",
    "description": "Keeps each site's sitemap current, adds a visitor Sitemap page and flags pages missing from the sitemap or, with Search installed, site search.",
    "product": {
        "group": "Capell Search & SEO",
        "tier": "free",
        "bundle": "search-seo"
    },
    "namespace": "Capell\\SiteDiscovery",
    "surfaces": ["admin", "frontend", "console"],
    "dependencies": {
        "requires": [
            "capell-app/admin",
            "capell-app/core",
            "capell-app/discovery-foundation",
            "capell-app/frontend"
        ],
        "supports": [
            "capell-app/agent-delivery",
            "capell-app/search",
            "capell-app/seo-suite",
            "capell-app/url-manager"
        ],
        "conflicts": []
    },
    "providers": {
        "metadata": [],
        "install": [],
        "runtime": [
            "Capell\\SiteDiscovery\\Providers\\SiteDiscoveryServiceProvider"
        ],
        "admin": [],
        "frontend": []
    },
    "contributes": [
        {
            "type": "admin-page",
            "class": "Capell\\SiteDiscovery\\Manifest\\PublicUrlRegistryPageContribution",
            "pageClass": "Capell\\SiteDiscovery\\Filament\\Pages\\PublicUrlRegistryPage",
            "labelKey": "capell-site-discovery::generic.public_url_registry",
            "permission": "View:PublicUrlRegistryPage"
        },
        {
            "type": "route",
            "class": "Capell\\SiteDiscovery\\Manifest\\SiteDiscoveryFrontendRoutesContribution"
        },
        {
            "type": "scheduled-job",
            "class": "Capell\\SiteDiscovery\\Manifest\\SiteDiscoveryIncrementalSitemapScheduleContribution",
            "command": "capell:xml-sitemap --incremental",
            "name": "capell-site-discovery:incremental-sitemap",
            "frequencyConfig": "capell-site-discovery.incremental_sitemap_schedule",
            "defaultFrequency": "dailyAt:02:30",
            "enabledWhen": "capell-site-discovery.incremental_sitemap_schedule.enabled=true"
        }
    ],
    "database": {
        "migrations": false,
        "settings": false,
        "requiredTables": []
    },
    "commands": {
        "install": null,
        "setup": null,
        "demo": null,
        "doctor": null,
        "sitemap": "capell:xml-sitemap"
    },
    "settings": [],
    "actions": {
        "setup": "Capell\\SiteDiscovery\\Actions\\SetupSiteDiscoveryPackageAction",
        "buildGeneratedOutputParityReport": "Capell\\SiteDiscovery\\Actions\\BuildGeneratedOutputParityReportAction",
        "buildPublicUrlRegistry": "Capell\\SiteDiscovery\\Actions\\BuildPublicUrlRegistryAction",
        "buildPublicUrlRepairQueue": "Capell\\SiteDiscovery\\Actions\\BuildPublicUrlRepairQueueAction",
        "generateSitemap": "Capell\\SiteDiscovery\\Actions\\GenerateSitemapAction",
        "validateSitemapQuality": "Capell\\SiteDiscovery\\Actions\\ValidateSitemapQualityAction"
    },
    "permissions": ["View:PublicUrlRegistryPage"],
    "capabilities": [
        "site-discovery",
        "site-discovery-admin",
        "site-discovery-console",
        "site-discovery-frontend"
    ],
    "security": {
        "riskTier": "standard",
        "publicSurface": {
            "routeNames": [
                "GET /sitemap-xml (capell-frontend.sitemap-xml.legacy)",
                "GET /sitemap.xml (capell-frontend.sitemap-xml)",
                "GET /{config:capell-site-discovery.indexnow.key}.txt (capell-frontend.indexnow-key)",
                "GET /{sitemapPrefix}/sitemap-xml (capell-frontend.sitemap-xml.legacy.prefixed)",
                "GET /{sitemapPrefix}/sitemap.xml (capell-frontend.sitemap-xml.prefixed)"
            ],
            "auth": "public",
            "csrfExemptRoutes": [],
            "signedRoutes": [],
            "tokenizedRoutes": [],
            "webhookRoutes": [],
            "throttledRoutes": [
                "GET /sitemap-xml (capell-frontend.sitemap-xml.legacy)",
                "GET /sitemap.xml (capell-frontend.sitemap-xml)",
                "GET /{config:capell-site-discovery.indexnow.key}.txt (capell-frontend.indexnow-key)",
                "GET /{sitemapPrefix}/sitemap-xml (capell-frontend.sitemap-xml.legacy.prefixed)",
                "GET /{sitemapPrefix}/sitemap.xml (capell-frontend.sitemap-xml.prefixed)"
            ]
        },
        "throttles": {
            "capell-site-discovery-sitemap": {
                "maxAttempts": 60,
                "decaySeconds": 60,
                "routes": [
                    "GET /sitemap-xml (capell-frontend.sitemap-xml.legacy)",
                    "GET /sitemap.xml (capell-frontend.sitemap-xml)",
                    "GET /{config:capell-site-discovery.indexnow.key}.txt (capell-frontend.indexnow-key)",
                    "GET /{sitemapPrefix}/sitemap-xml (capell-frontend.sitemap-xml.legacy.prefixed)",
                    "GET /{sitemapPrefix}/sitemap.xml (capell-frontend.sitemap-xml.prefixed)"
                ]
            }
        },
        "sensitiveData": {
            "encryptedFields": [],
            "hashedTokenFields": [],
            "redactedOutputClasses": [
                "Capell\\SiteDiscovery\\Actions\\RedactIndexNowNotificationErrorMessageAction",
                "Capell\\SiteDiscovery\\Support\\IndexNow\\IndexNowUrlChangeNotifier"
            ],
            "plaintextJustifications": []
        },
        "publicOutput": {
            "cacheSafe": true,
            "forbidAuthoringSurface": true,
            "forbidSecrets": true,
            "forbidPublicBladeQueries": true
        },
        "externalHttpClients": {
            "requiresTimeouts": true,
            "requiresSecretRedaction": true,
            "clients": [
                "Capell\\SiteDiscovery\\Support\\IndexNow\\IndexNowUrlChangeNotifier"
            ]
        },
        "adminSurface": {
            "authorization": "permissions",
            "permissions": ["View:PublicUrlRegistryPage"]
        }
    },
    "performance": {
        "frontendRenderBudgetMs": 20,
        "adminQueryBudget": 40,
        "cacheTags": ["site-discovery"],
        "cacheSafety": {
            "cacheable": false,
            "variesBy": ["site", "locale"],
            "sensitiveOutput": false,
            "invalidationSources": [
                {
                    "model": "Capell\\Core\\Models\\Page",
                    "events": ["saved", "deleted"]
                },
                {
                    "model": "Capell\\Core\\Models\\Site",
                    "events": ["created"]
                }
            ],
            "queueInvalidation": true
        }
    },
    "healthChecks": [
        {
            "key": "site-discovery.public-urls",
            "label": "Discoverable public URLs are resolved with site and language scope.",
            "class": "Capell\\SiteDiscovery\\Health\\SiteDiscoveryHealthCheck",
            "severity": "critical",
            "surface": "frontend"
        },
        {
            "key": "site-discovery.xml-sitemaps",
            "label": "XML sitemap generation writes domain-scoped sitemap files.",
            "class": "Capell\\SiteDiscovery\\Health\\SiteDiscoveryHealthCheck",
            "severity": "critical",
            "surface": "console"
        },
        {
            "key": "site-discovery.incremental",
            "label": "Incremental sitemap generation skips unchanged URL maps.",
            "class": "Capell\\SiteDiscovery\\Health\\SiteDiscoveryHealthCheck",
            "severity": "warning",
            "surface": "console"
        },
        {
            "key": "site-discovery.html-sitemap",
            "label": "HTML sitemap page renders discoverable page hierarchy.",
            "class": "Capell\\SiteDiscovery\\Health\\SiteDiscoveryHealthCheck",
            "severity": "warning",
            "surface": "frontend"
        }
    ],
    "commercial": {
        "proposedLicense": "free",
        "requestedCertification": "first-party",
        "supportPolicy": "priority",
        "privateDocsRequested": true
    },
    "marketplace": {
        "summary": "Sitemaps that update as pages are saved, a visitor Sitemap page and a report of pages missing from the sitemap or optional site search.",
        "description": "Publish a sitemap for each site and have it rebuilt after pages are saved or deleted. Set pages aside with the hidden or noindex settings, give visitors a Sitemap page, and review published pages missing from the sitemap or, when Search is installed, your site search. Filters narrow the list by site or language.",
        "problem": "Search engines may miss published pages when the sitemap is out of date.",
        "outcome": "Every visible page is listed in a checked sitemap that updates on save.",
        "faq": [
            {
                "question": "Which pages are left out of the sitemap?",
                "answer": "Hidden pages and pages marked noindex, a setting that asks search engines to skip a page, are left out. Repeated addresses are dropped too."
            },
            {
                "question": "How soon does a saved change reach the sitemap?",
                "answer": "About a minute after you save, once background jobs have handled it. Your developer or host has to keep those jobs running."
            },
            {
                "question": "Does a new site get a sitemap automatically?",
                "answer": "Yes, once it has a domain. A site without a domain is skipped."
            },
            {
                "question": "Can I see which published pages are missing from the sitemap?",
                "answer": "Yes. A report under Insights & health lists published pages that are missing from the sitemap or, when a search package is installed, from your site search. Each row gives the reason and the next step."
            }
        ],
        "screenshots": [
            {
                "path": "docs/assets/marketplace/extension-card.jpg",
                "alt": "Site Discovery listing card with two admin windows showing Pages and Sites lists with Generate sitemap buttons",
                "caption": "Listing artwork for the package, not a view of the working admin."
            },
            {
                "path": "docs/screenshots/page-sitemap-action.png",
                "alt": "Pages list in the admin with an SEO overview of page counts and a Sitemap button above the table of pages",
                "caption": "Reach the sitemap from the Pages screen."
            },
            {
                "path": "docs/screenshots/site-sitemap-action.png",
                "alt": "Sites list with a row menu open showing Edit theme, Edit blueprint, Replicate, Delete and Sitemap",
                "caption": "Each site has its own Sitemap option in its row menu."
            },
            {
                "path": "docs/screenshots/sitemap-generation-tool.png",
                "alt": "Sitemap page in the admin with site and language pickers above a tree of page titles that each link out",
                "caption": "Review a site's sitemap before publishing or when an address seems to be missing."
            },
            {
                "path": "docs/screenshots/html-sitemap-page.png",
                "alt": "Public Sitemap page listing the site's pages as a column of links beside a Latest Articles panel",
                "caption": "Visitors can read the same list of pages on a Sitemap page."
            },
            {
                "path": "docs/screenshots/public-url-registry-page.png",
                "alt": "Public URL page with attention counts and entries marked Missing for the sitemap, AI discovery and HTML cache",
                "caption": "See which public addresses are missing from an output and what to do next."
            },
            {
                "path": "docs/screenshots/public-url-quality-report.png",
                "alt": "Quality report scrolled down, with blog addresses marked Missing and a table showing which outputs include each one",
                "caption": "Each row gives the reason an address is missing and the next step."
            }
        ],
        "categories": ["admin", "console", "frontend", "search-seo"]
    },
    "contributionTraceability": {
        "deferredContributions": [],
        "contributions": [
            {
                "type": "content-widget",
                "key": "renderable:page:site.sitemap",
                "providerBucket": "runtime"
            },
            {
                "type": "model",
                "key": "model-interceptor:Capell\\Core\\Models\\Blueprint:Capell\\SiteDiscovery\\Support\\Interceptors\\SitemapPageTypeInterceptor:970ccb6fbdcc2e21892660a968898504",
                "providerBucket": "runtime"
            }
        ]
    }
}
