{
    "name": "capell-app/site-discovery",
    "description": "Sitemaps for Capell sites, rebuilt as pages change, with a visitor Sitemap page and an admin coverage list.",
    "keywords": [
        "capell",
        "discovery",
        "sitemap",
        "seo",
        "laravel",
        "filamentphp",
        "cms"
    ],
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "capell-app/admin": "^1.0.78",
        "capell-app/core": "^1.0.79",
        "capell-app/discovery-foundation": "^1.0",
        "capell-app/frontend": "^1.0.79"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Capell\\SiteDiscovery\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Capell\\SiteDiscovery\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Capell\\SiteDiscovery\\Providers\\SiteDiscoveryServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    },
    "prefer-stable": true,
    "type": "library",
    "homepage": "https://github.com/capell-app/site-discovery",
    "authors": [
        {
            "name": "Capell Team",
            "email": "team@capell.app",
            "role": "Developer"
        }
    ],
    "support": {
        "source": "https://github.com/capell-app/capell-packages",
        "docs": "https://docs.capell.app/packages/site-discovery"
    }
}
